# Git LFS - Track large binary files efficiently
# https://git-lfs.github.com/

# Ghostscript binaries (embedded in app bundle)
src-tauri/binaries/gs-* filter=lfs diff=lfs merge=lfs -text
src-tauri/binaries/*.exe filter=lfs diff=lfs merge=lfs -text

# ICC Profile files (color management)
src-tauri/resources/icc-profiles/*.icc filter=lfs diff=lfs merge=lfs -text
src-tauri/resources/icc-profiles/*.icm filter=lfs diff=lfs merge=lfs -text

# Other large binary assets
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
